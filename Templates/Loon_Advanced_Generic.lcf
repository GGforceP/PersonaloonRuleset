# 地区策略
香港手动策略=select, 香港节点, img-url=https://raw.githubusercontent.com/Orz-3/mini/master/Color/HK.png
台湾手动策略=select, 台湾节点, img-url=https://raw.githubusercontent.com/Orz-3/mini/master/Color/TW.png
日本手动策略=select, 日本节点, img-url=https://raw.githubusercontent.com/Orz-3/mini/master/Color/JP.png
韩国手动策略=select, 韩国节点, img-url=https://raw.githubusercontent.com/Orz-3/mini/master/Color/KR.png
新国手动策略=select, 新国节点, img-url=https://raw.githubusercontent.com/Orz-3/mini/master/Color/SG.png
美国手动策略=select, 美国节点, img-url=https://raw.githubusercontent.com/Orz-3/mini/master/Color/US.png
游戏手动策略=select, 游戏节点, img-url=https://raw.githubusercontent.com/Orz-3/mini/master/Color/GAME.png
全球手动策略=select, 全球节点, img-url=https://raw.githubusercontent.com/Orz-3/mini/master/Color/Global.png
香港自动策略=url-test, 香港节点, interval = 300, tolerance = 150, img-url=https://raw.githubusercontent.com/Orz-3/mini/master/Color/HK.png
台湾自动策略=url-test, 台湾节点, interval = 300, tolerance = 150, img-url=https://raw.githubusercontent.com/Orz-3/mini/master/Color/TW.png
日本自动策略=url-test, 日本节点, interval = 300, tolerance = 150, img-url=https://raw.githubusercontent.com/Orz-3/mini/master/Color/JP.png
韩国自动策略=url-test, 韩国节点, interval = 300, tolerance = 150, img-url=https://raw.githubusercontent.com/Orz-3/mini/master/Color/KR.png
新国自动策略=url-test, 新国节点, interval = 300, tolerance = 150, img-url=https://raw.githubusercontent.com/Orz-3/mini/master/Color/SG.png
美国自动策略=url-test, 美国节点, interval = 300, tolerance = 150, img-url=https://raw.githubusercontent.com/Orz-3/mini/master/Color/US.png

# --------------------------------
# 兜底策略后备
兜底后备策略=fallback, 香港自动场景, 台湾自动场景, 日本自动场景, 韩国自动场景, 新国自动场景, 美国自动场景, interval = 300, max-timeout=2000, img-url=https://github.com/shindgewongxj/WHATSINStash/raw/main/icon/fallback.png
全球自动策略 = url-test,全球节点,interval = 300,tolerance = 150
区域选择 = ssid,default=全球自动策略,cellular=全球自动策略,"YOUR_HOME_WIFI"=DIRECT
常用AI = ssid,default=新国自动策略,cellular=新国自动策略,"YOUR_HOME_WIFI"=DIRECT
Yandex = ssid,default=美国自动策略,cellular=美国自动策略,"YOUR_HOME_WIFI"=DIRECT
Linux代理 = ssid,default=香港自动策略,cellular=香港自动策略,"YOUR_HOME_WIFI"=DIRECT
微软服务 = ssid,default=DIRECT,cellular=DIRECT,"YOUR_HOME_WIFI"=DIRECT
Edge_New_Tab = ssid,default=香港自动策略,cellular=香港自动策略,"YOUR_HOME_WIFI"=DIRECT
国外社交媒体 = ssid,default=香港自动策略,cellular=香港自动策略,"YOUR_HOME_WIFI"=DIRECT
谷歌服务 = ssid,default=香港自动策略,cellular=香港自动策略,"YOUR_HOME_WIFI"=DIRECT
即时通讯 = ssid,default=香港自动策略,cellular=香港自动策略,"YOUR_HOME_WIFI"=DIRECT
苹果服务 = ssid,default=DIRECT,cellular=DIRECT,"YOUR_HOME_WIFI"=DIRECT
国外流媒体 = ssid,default=新国自动策略,cellular=新国自动策略,"YOUR_HOME_WIFI"=DIRECT
Steam = ssid,default=香港自动策略,cellular=香港自动策略,"YOUR_HOME_WIFI"=DIRECT
测速工具 = ssid,default=全球自动策略,cellular=全球自动策略,"YOUR_HOME_WIFI"=DIRECT
非常规端口 = ssid,default=DIRECT,cellular=DIRECT,"YOUR_HOME_WIFI"=DIRECT
漏网之鱼 = ssid,default=兜底后备策略,cellular=兜底后备策略,"YOUR_HOME_WIFI"=DIRECT
Emby = ssid,default=DIRECT,cellular=DIRECT,"YOUR_HOME_WIFI"=DIRECT
成人网站 = ssid,default=全球自动策略,cellular=全球自动策略,"YOUR_HOME_WIFI"=DIRECT

[Rule]
FINAL,漏网之鱼

